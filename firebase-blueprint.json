{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Private workspace root document for an authenticated construction accountant.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "companyName", "createdAt", "updatedAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Construction customer or client account record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 240 },
        "gstNumber": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "phone", "address", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Construction site project linked to a client and contract value.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "clientId": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 140 },
        "contractValue": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "ON_HOLD", "COMPLETED"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "contractValue", "status", "createdAt", "updatedAt"]
    },
    "LedgerTransaction": {
      "title": "LedgerTransaction",
      "description": "Income, material (Cement/Steel/Sand), labour/contractor, or daily site expense entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["INCOME_CUSTOMER_PAYMENT", "EXPENSE_MATERIAL", "EXPENSE_LABOUR", "EXPENSE_SITE"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 48 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "partyName": { "type": "string", "maxLength": 120 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 32 },
        "unitRate": { "type": "number" },
        "amount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["CASH", "UPI", "BANK_TRANSFER", "CHEQUE"] },
        "referenceNo": { "type": "string", "maxLength": 64 },
        "dateMillis": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "type", "category", "title", "partyName", "amount", "paymentMode", "dateMillis", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "User workspace root for Chola Empire Construction Accounts."
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Client directory and contact details owned by the user."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Construction projects owned by the user."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/LedgerTransaction" },
      "description": "Project-wise income, material, labour, and daily site expense entries."
    }
  }
}
